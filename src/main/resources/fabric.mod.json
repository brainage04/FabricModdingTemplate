{
	"schemaVersion": 1,
	"id": "${mod_id}",
	"version": "${mod_version}",
	"name": "${mod_name}",
	"description": "My Fabric modding template.",
	"authors": [
		"brainage04"
	],
	"contact": {
		"homepage": "https://github.com/brainage04/FabricTemplateServer",
		"sources": "https://github.com/brainage04/FabricTemplateServer"
	},
	"license": "MIT",
	"icon": "assets/fabrictemplateserver/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.example.FabricTemplateServer"
		],
		"client": [
			"com.example.FabricTemplateServerClient"
		]
	},
	"mixins": [
		"fabrictemplateserver.mixins.json"
	],
	"depends": {
		"fabricloader": ">=${loader_version}",
		"minecraft": "~${minecraft_version}",
		"java": ">=21",
		"fabric-api": "*",
		"fzzy_config": ">=0.7.5"
	},
    "accessWidener": "fabrictemplateserver.accesswidener"
}
